rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Entitlement doc: `pro` is the paywall flag. Clients can read it and create the initial
    // (unpaid) doc, but can never flip it to true themselves — only the Stripe webhook Cloud
    // Function (Admin SDK, bypasses these rules) is allowed to grant `pro: true`.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.pro == false;
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.pro == resource.data.pro;

      // Actual habit data — cloud sync is a Pro-only perk, gated on the entitlement above.
      match /data/state {
        allow read, write: if request.auth != null && request.auth.uid == userId
                            && get(/databases/$(database)/documents/users/$(userId)).data.pro == true;
      }
    }

    // Sync codes map a bearer code -> uid for anonymous device pairing. These are a secret
    // credential, minted and redeemed only by Cloud Functions (Admin SDK bypasses rules) —
    // never readable or writable directly by clients.
    match /syncCodes/{code} {
      allow read, write: if false;
    }
  }
}
